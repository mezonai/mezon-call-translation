# Dockerfile cho LiveKit Agent
FROM python:3.12-slim

# Cài đặt system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    curl \
    procps \
    lsof \
    net-tools \
    libasound2-dev \
    portaudio19-dev \
    libportaudio2 \
    libportaudiocpp0 \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Tạo thư mục làm việc
WORKDIR /app

# Copy requirements và cài đặt Python dependencies
COPY requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt

# Copy agent code
COPY Architect_MultiClient_Server/agents/ ./agents/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose ports
# - 8000: FastAPI dispatch API
# - 8080: LiveKit agent (if needed)
EXPOSE 8000
EXPOSE 8080

# Command để chạy agent
CMD ["python", "agents/main.py", "start"]
