# Per-instance overrides for the record-service@.service template unit.
# One file per instance, named /etc/record-service/instance-<N>.env where
# <N> matches the %i you pass to `systemctl start record-service@<N>`.
#
# Port and state dir MUST be unique per instance -- two instances sharing
# either will corrupt each other (state dir: PLAN.md D16 bug #1 territory;
# port: the second instance simply fails to bind).
#
# Whatever sits in front of these instances (nginx stream / grpc-native LB
# / DNS round-robin -- NOT decided yet, record-service itself has no
# opinion) needs to know about every port you allocate here.

RECORD_SERVICE_GRPC_PORT=50051

# StateDirectory=record-service/%i in the unit file creates and chowns
# this automatically on start -- must match <instance-dir-name> exactly.
RECORD_STATE_DIR=/var/lib/record-service/1

# Uncomment only if binding to a specific interface rather than all of them:
# RECORD_SERVICE_GRPC_HOST=0.0.0.0
