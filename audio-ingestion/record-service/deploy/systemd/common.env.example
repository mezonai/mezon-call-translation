# Shared across every record-service instance on this host.
# Copy to /etc/record-service/common.env (chmod 640, owned by
# root:record-service -- it holds secrets) and fill in real values.
# Full list of env vars: src/record_service/config.py

# --- MinIO / S3 ---
MINIO_ENDPOINT=minio.internal:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=call-recordings
MINIO_REGION=us-east-1
MINIO_SECURE=0
MINIO_FORCE_PATH_STYLE=1

# --- orchestrator ---
ORCHESTRATOR_BASE_URL=http://orchestrator.internal:8000
# Must match orchestrator's INTERNAL_API_SECRET (verify_api_key).
ORCHESTRATOR_API_KEY=changeme
RECORDING_EVENTS_PATH=/api/v2/recordings/events
ORCHESTRATOR_TIMEOUT_SECONDS=5

# --- recording policy (PLAN.md D5/D11/D12) ---
RECORD_PART_SIZE_MB=8
RECORD_MAX_UPLOAD_RETRIES=3
RECORD_UPLOAD_RETRY_BASE_DELAY_SECONDS=0.2
RECORD_GRACE_PERIOD_SECONDS=45
RECORD_BYTE_RATE_TOLERANCE=0.5
RECORD_DROP_RATE_WARNING_THRESHOLD=0.1
RECORD_MAX_REPORT_RETRIES=3
RECORD_REPORT_RETRY_BASE_DELAY_SECONDS=0.5
RECORD_RECONCILE_INTERVAL_SECONDS=30

# --- misc ---
LOG_LEVEL=INFO

# NOT set here on purpose -- these vary per instance, see instance.env.example:
#   RECORD_SERVICE_GRPC_HOST / RECORD_SERVICE_GRPC_PORT
#   RECORD_STATE_DIR
