# Shared across every audio-processing-service instance on this host --
# unlike record-service, no per-instance file exists (no port/state dir to
# split), so this is the only env file needed.
# Copy to /etc/audio-processing-service/common.env (chmod 640, owned by
# root:audio-processing-service -- it holds secrets) and fill in real values.
# Full list of env vars: src/audio_processing_service/config.py

# --- Redis (consumer group, audio-ingestion PLAN.md D17/D28) ---
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# --- MinIO / S3 -- SAME bucket record-service writes raw captures to
# (PLAN.md D28 point 2: reuse it, only the .pcm -> .ogg suffix changes) ---
MINIO_ENDPOINT=minio.internal:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=call-recordings
MINIO_REGION=us-east-1
MINIO_SECURE=0
MINIO_FORCE_PATH_STYLE=1

# --- orchestrator ---
ORCHESTRATOR_BASE_URL=http://orchestrator.internal:8000
# Must match orchestrator's INTERNAL_API_SECRET (verify_api_key) -- same
# secret record-service's common.env uses for ORCHESTRATOR_API_KEY.
ORCHESTRATOR_API_KEY=changeme
RECORDING_EVENTS_PATH=/api/v2/recordings/events
ORCHESTRATOR_TIMEOUT_SECONDS=5

# --- transcode (PLAN.md D28 point 1: hardcoded sample_rate/channels to
# match record-service's fixed capture format, not read from Track
# metadata) ---
FFMPEG_PATH=ffmpeg
TRANSCODE_SAMPLE_RATE=16000
TRANSCODE_CHANNELS=1
TRANSCODE_OPUS_BITRATE_KBPS=32
TRANSCODE_FFMPEG_TIMEOUT_SECONDS=300

# --- misc ---
LOG_LEVEL=INFO
