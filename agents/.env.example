# --- worker-manager: NATS dispatch ---
NATS_URL=nats://127.0.0.1:4222
AGENT_DISPATCH_SUBJECT=mezon_sfu_hook_event
AGENT_WORKER_QUEUE_GROUP=agent-worker-manager
AGENT_BIN_PATH=./bin/agent
AGENT_STOP_TIMEOUT_SECONDS=20

# --- worker-manager: interim agent_user_id workaround, see README.md ---
# Required -- Start() errors without it. Pick something that won't collide
# with a real Mezon user id; coordinate the real value with BE mezon later.
AGENT_USER_ID_BASE=900000001

# --- agent: mezon-sfu connection ---
SFU_WS_URL=ws://127.0.0.1:8000/ws
SFU_JWT_SECRET=default

# --- agent: only used when running bin/agent standalone, not via
#     worker-manager (see header note above) ---
# ROOM_ID=1
# AGENT_ROLE=audience

# --- agent: orchestrator_service ---
ORCHESTRATOR_BASE_URL=http://localhost:8002
INTERNAL_API_SECRET=

# --- agent: record-service (gRPC) ---
# recordclient currently dials plaintext only (no TLS support) -- see
# internal/recordclient/client.go. Pointing this at a dev host that requires
# TLS will fail the connection; recording just degrades gracefully off, it
# doesn't block the agent from joining.
# Testing locally against real MinIO (not just "does it dial"): run
# `cd audio-ingestion && docker compose up -d --build`
# (audio-ingestion/docker-compose.yml, see audio-ingestion/record-service/README.md)
# then point this at localhost, not the docker-network hostname:
RECORD_SERVICE_GRPC_ADDR=localhost:50051

# --- agent: STT (Vosk WS) ---
WS_HOST=localhost
WS_PORT=8000

# --- agent: TTS ---
TTS_SERVICE_BASE_URL=
TTS_SAMPLE_RATE=24000

LOG_LEVEL=info
# --- agents-bot active-room registration for chat forwarding ---
AGENTS_BOT_BASE_URL=http://localhost:8003
