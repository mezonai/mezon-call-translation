# =============================================================================
# MEZON CALL TRANSLATION - PER-CLIENT PIPELINE CONFIGURATION
# =============================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_LOG_LEVEL=INFO
SERVER_MAX_CONNECTIONS=1000

# Per-Client Pipeline Configuration
MAX_CONCURRENT_CLIENTS=50  # Maximum number of concurrent clients with dedicated pipelines

# Audio Processing Configuration
SAMPLE_RATE=16000
MIN_TEXT_LENGTH=2
CHANNELS=1

# STT Configuration (Per-Pipeline)
VOSK_MODEL_PATH=model/Transcription/en-model
VOSK_MIN_CHUNKS=2
VOSK_MAX_CHUNKS=8
VOSK_MIN_TIME_THRESHOLD=0.1
VOSK_MAX_TIME_THRESHOLD=0.4
METRICS_INTERVAL_SEC=10.0

# Queue Configuration (Per-Pipeline)
AUDIO_QUEUE_MAXSIZE=100  # Per-client audio queue size

# Circuit Breaker Configuration
STT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
STT_CIRCUIT_BREAKER_TIMEOUT=60.0
STT_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3

# Health & Monitoring
LOG_LEVEL=INFO
LOG_APP_FILE=logs/app.log
LOG_METRICS_FILE=logs/metrics.log
LOG_MAX_FILE_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Performance Tuning
CLIENT_PIPELINE_BUFFER_SIZE=1600  # Audio buffer size per pipeline
PIPELINE_PROCESSING_TIMEOUT=5.0  # Max time for pipeline processing
RESOURCE_CLEANUP_AGGRESSIVE=false  # More aggressive resource management

# Development/Debug Settings
PIPELINE_DEBUG_ENABLED=false  # Enable detailed pipeline debugging
PIPELINE_METRICS_DETAILED=false  # Detailed pipeline metrics logging
FORCE_PIPELINE_RECREATION=false  # Force recreation of pipelines on each request

# Docker & Scaling Configuration  
DOCKER_SCALE_REPLICAS=1  # Number of server replicas (use with docker-compose scale)
LOAD_BALANCER_STICKY_SESSIONS=false  # Enable sticky sessions for client affinity