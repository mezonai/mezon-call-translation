# Bot Gateway - Environment Variables
# Copy to .env and fill in values

# Required: Mezon bot credentials
MEZON_BOT_ID=your_bot_app_id
MEZON_BOT_TOKEN=your_bot_token

# Mezon server connection (defaults to gw.mezon.ai:443 with SSL)
# MEZON_HOST=dev-mezon.nccsoft.vn
# MEZON_PORT=443
# MEZON_USE_SSL=true
# MEZON_TLS_INSECURE=false        # set true for dev self-signed certs

# HTTP server port for agent API
GATEWAY_PORT=8003

# Orchestrator service connection (for chat forwarding)
ORCHESTRATOR_BASE_URL=http://localhost:8002
INTERNAL_API_SECRET=your_shared_api_key
