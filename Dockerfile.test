# Dockerfile for testing setup scripts
# This simulates a fresh environment like cloning from GitHub

FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies (minimal tools to bootstrap)
RUN apt-get update && apt-get install -y \
    sudo \
    wget \
    curl \
    git \
    unzip \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for testing
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Set working directory
WORKDIR /home/testuser/mezon-call-translation

# Copy entire project (simulating git clone)
COPY --chown=testuser:testuser . .


# Make scripts executable
RUN chmod +x scripts/*.sh

# Set default command to bash for interactive testing
CMD ["/bin/bash"]
