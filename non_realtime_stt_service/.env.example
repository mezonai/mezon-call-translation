# ============================================================================
# Server Configuration
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
SERVER_LOG_LEVEL=INFO

# ============================================================================
# Non-realtime Whisper Marker Configuration
# ============================================================================
# Model name passed to faster-whisper (downloads/caches automatically).
# E.g.: large-v3-turbo, medium, small, or a local CTranslate2 directory path.
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_LANGUAGE=vi
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_TEMPERATURE=0.0, 0.4

# ============================================================================
# MinIO / S3 Storage Configuration
# ============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=livekit-recordings
MINIO_SECURE=false

# ============================================================================
# Redis Configuration (Streams & Queue)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLAIM_MIN_IDLE_TIME_MS=60000
REDIS_BLOCK_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=30.0
REDIS_SOCKET_CONNECT_TIMEOUT=10.0
REDIS_HEARTBEAT_INTERVAL_SEC=10.0
REDIS_WORKER_TIMEOUT_SEC=30.0

# ============================================================================
# Audio Format Configuration
# ============================================================================
SAMPLE_RATE=16000
CHANNELS=1

# ============================================================================
# Transcription Batching Configuration
# ============================================================================
# Number of final transcript segments sent in one Redis save message.
TRANSCRIPT_CHUNK_SIZE=50

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_APP_FILE=logs/app.log
LOG_METRICS_FILE=logs/metrics.log

# ============================================================================
# Metrics Configuration (Prometheus)
# ============================================================================
METRICS_ENABLED=false
METRICS_SYSTEM=true
METRICS_STT=true
METRICS_UPDATE_INTERVAL=5.0
