# =============================================================================
# LiveKit Configuration
# =============================================================================
# LiveKit WebSocket URL for real-time communication
LIVEKIT_URL=wss://your-livekit-server.com

# LiveKit API credentials for authentication
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LiveKit HTTP URL for REST API calls
LIVEKIT_HTTP_URL=https://meet.nccsoft.vn

# Unique agent identifier (generate with: python -c "import uuid; print(uuid.uuid4())")
LIVEKIT_AGENT_NAME=e7e1b7c2-2b6e-4e2a-9c1d-7f8e2a1b2c3d

AUTHENTICATE_ACCOUNT_URL=https://dev-mezon.nccsoft.vn:8088/v2/apps/authenticate/token # dev
# AUTHENTICATE_ACCOUNT_URL=https://gw.mezon.ai:443/v2/apps/authenticate/token #production


# =============================================================================
# Server Configuration
# =============================================================================
# Host address for the agent API server (0.0.0.0 for all interfaces)
SERVER_HOST=0.0.0.0

# Port for the agent API server
SERVER_PORT=8000

# =============================================================================
# Vosk Speech Recognition Configuration
# =============================================================================
# Path to Vosk model directory (download from https://alphacephei.com/vosk/models)
VOSK_MODEL_PATH=/app/models/vosk-model

# Vosk WebSocket server connection settings
WS_HOST=vosk
WS_PORT=8000

# =============================================================================
# MongoDB Configuration (Optional - for transcript persistence)
# =============================================================================
# Enable/disable MongoDB transcript storage (true/false)
ENABLE_MONGODB=false

# MongoDB connection string
MONGODB_URI=mongodb://mongodb:27017

# Database name for storing transcripts
MONGODB_DATABASE=mezon_transcripts

# MongoDB authentication (if using authentication)
MONGODB_USERNAME=admin
MONGODB_PASSWORD=your-password
MONGODB_HOST=localhost
MONGODB_PORT=27017

# =============================================================================
# Transcript API Authentication
# =============================================================================
# Enable/disable API authentication for transcript endpoints (true/false)
TRANSCRIPT_AUTH_ENABLED=true

# Secret key for API authentication (generate a strong random key)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSCRIPT_API_SECRET=your-secret-key-here

# Collection name for transcript documents
MONGODB_COLLECTION=transcripts

# =============================================================================
# Transcript Manager Configuration
# =============================================================================
# Time to wait for silence before sending buffered transcripts (seconds)
# When user stops speaking for this duration, all buffered transcripts are sent
# Range: 0.5 - 30.0, Default: 5.0
TRANSCRIPT_SILENCE_TIMEOUT=5.0

# =============================================================================
# TTS Configuration (Optional - Text-to-Speech with Silero)
# =============================================================================
# Enable/disable TTS functionality (true/false)
ENABLE_TTS=false

# Path to Silero TTS model file
TTS_MODEL_PATH=models/silero_v3_en.pt

# Note: TTS receives control messages via DataChannel (topic='tts_control')
# Expected message format: {"type": "tts_request", "text": "Hello world"}

# TTS speaker voice (en_0, en_1, ..., en_117 for English)
TTS_SPEAKER=en_0

# TTS audio output sample rate (16000, 24000, or 48000 Hz)
TTS_SAMPLE_RATE=48000

# =============================================================================
# Audio Processing Configuration
# =============================================================================
# Audio sample rate for processing (8000, 16000, 48000 Hz)
SAMPLE_RATE=16000

# Number of audio channels (1 for mono, 2 for stereo)
CHANNELS=1

# VAD (Voice Activity Detection) sensitivity (0.0 to 1.0, lower = more sensitive)
VAD_THRESHOLD=0.5

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Performance Tuning (Advanced)
# =============================================================================
# Maximum WebSocket message queue size
# WS_MAX_QUEUE_SIZE=1000

# WebSocket ping interval in seconds
# WS_PING_INTERVAL=20

# WebSocket ping timeout in seconds
# WS_PING_TIMEOUT=10

# Audio buffer size for processing
# AUDIO_BUFFER_SIZE=4096

# Number of worker threads for audio processing
# AUDIO_WORKER_THREADS=2
