# ============================================================================
# LiveKit Configuration (REQUIRED - Sensitive)
# ============================================================================
# LiveKit WebSocket URL (wss://...)
LIVEKIT_URL=

# LiveKit HTTP URL for API calls
LIVEKIT_HTTP_URL=

# LiveKit API credentials (REQUIRED)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit agent name
LIVEKIT_AGENT_NAME=agent-e7e1b7c2-2b6e-4e2a-9c1d-7f8e2a1b2c3d


# ============================================================================
# STT Service Configuration
# ============================================================================
# WebSocket connection to STT service
STT_HOST=localhost
STT_PORT=8000

# Authentication (if required by STT service)
STT_AUTH_TOKEN=
STT_API_KEY=
STT_AUTH_HEADER=Authorization

# ============================================================================
# Logging
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Advanced Configuration (Optional - Uncomment to customize)
# ============================================================================

# Audio Configuration
# AUDIO_SAMPLE_RATE=16000
# AUDIO_CHANNELS=1
# AUDIO_CHUNK_DURATION_MS=10

# VAD Configuration
# VAD_ENERGY_THRESH=0.005
# VAD_SILENT_THRESHOLD_MS=500

# STT Service Connection
# STT_RECONNECT_MAX_ATTEMPTS=5
# STT_CONNECTION_TIMEOUT=10.0
# STT_PING_INTERVAL=30

# Transcript Configuration
# TRANSCRIPT_SILENCE_TIMEOUT=5.0


# MinIO / S3 upload (for START_AUDIO_RECORDING)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=livekit-recordings
MINIO_REGION=us-east-1
MINIO_SECURE=0
MINIO_FORCE_PATH_STYLE=1

# Recording upload tuning
RECORDING_UPLOAD_ENABLED=1
RECORDING_UPLOAD_PART_SIZE_MB=8
RECORDING_UPLOAD_MAX_RETRIES=3
RECORDING_FFMPEG_PATH=ffmpeg
RECORDING_OPUS_BITRATE_KBPS=32

INTERNAL_API_SECRET=your-secure-random-secret-key-here
