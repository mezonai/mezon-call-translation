# ============================================================================
# Server Configuration
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_LOG_LEVEL=INFO
MAX_CONCURRENT_CLIENTS=50

# ============================================================================
# Non-realtime Whisper Marker Configuration
# ============================================================================

# Model name is passed to faster-whisper; it downloads/caches automatically.
# A local CTranslate2 directory is also accepted for offline deployments.
# faster-whisper downloads/caches this model automatically on first startup.
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_LANGUAGE=vi
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_TEMPERATURE=0.0, 0.4

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Metrics Configuration (Prometheus)
# ============================================================================
METRICS_ENABLED=false
METRICS_HTTP=true
METRICS_WS=true
METRICS_SYSTEM=true
METRICS_STT=true
METRICS_UPDATE_INTERVAL=5.0

# ============================================================================
# MinIO/S3 Storage Configuration (Optional)
# ============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=livekit-recordings
MINIO_SECURE=false

# ============================================================================
# MongoDB Configuration (Optional)
# ============================================================================

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=rootpassword
MONGODB_DATABASE=mezon_transcripts
MONGODB_COLLECTION=transcripts

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLAIM_MIN_IDLE_TIME_MS=60000
REDIS_BLOCK_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3

# ============================================================================
# Advanced Configuration (Optional - Uncomment to customize)
# ============================================================================

# Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
MIN_TEXT_LENGTH=2

# Nemotron STT Configuration
NEMOTRON_MODEL_PATH=nemotron-3.5-asr-streaming-0.6b-onnx-int4
NEMOTRON_LANGUAGE_ID=0
NEMOTRON_EMPTY_PIECE_LIMIT=2

# Pipeline batching compatibility settings. Nemotron's exact model block size
# is read from genai_config.json rather than configured here.
NEMOTRON_MIN_CHUNKS=2
NEMOTRON_MAX_CHUNKS=4
NEMOTRON_MIN_TIME_THRESHOLD=0.1
NEMOTRON_MAX_TIME_THRESHOLD=0.2

# Queue Configuration
# Number of final transcript segments sent in one Redis save message. This does
# not affect VAD, Whisper model input, or transcription quality.
AUDIO_QUEUE_MAXSIZE=500
TRANSCRIPT_CHUNK_SIZE=50

# Circuit Breaker
STT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

