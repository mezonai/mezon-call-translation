# ============================================================================
# Server Configuration
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_LOG_LEVEL=INFO
MAX_CONCURRENT_CLIENTS=50

# ============================================================================
# Whisper Transcription Configuration
# ============================================================================

# Whisper model configuration
WHISPER_MODEL_SIZE=medium
WHISPER_VAD_FILTER=true
WHISPER_SAMPLE_RATE=16000
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=4

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Metrics Configuration (Prometheus)
# ============================================================================
METRICS_ENABLED=false
METRICS_HTTP=true
METRICS_WS=true
METRICS_SYSTEM=true
METRICS_STT=true
METRICS_UPDATE_INTERVAL=5.0

# ============================================================================
# MinIO/S3 Storage Configuration (Optional)
# ============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=livekit-recordings
MINIO_SECURE=false

# ============================================================================
# MongoDB Configuration (Optional)
# ============================================================================

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=rootpassword
MONGODB_DATABASE=mezon_transcripts
MONGODB_COLLECTION=transcripts

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLAIM_MIN_IDLE_TIME_MS=60000
REDIS_BLOCK_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3

# ============================================================================
# Advanced Configuration (Optional - Uncomment to customize)
# ============================================================================

#Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
MIN_TEXT_LENGTH=2

#Vosk STT Configuration
VOSK_MODEL_PATH=vosk-model-small-en-us-0.15
VOSK_MIN_CHUNKS=2
VOSK_MAX_CHUNKS=8
VOSK_MIN_TIME_THRESHOLD=0.1
VOSK_MAX_TIME_THRESHOLD=0.4

#Queue Configuration
AUDIO_QUEUE_MAXSIZE=500

#Circuit Breaker
STT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Internal service
ORCHESTRATOR_URL=http://localhost:8002
ORCHESTRATOR_INTERNAL_API_KEY=my-secret-internal-key
