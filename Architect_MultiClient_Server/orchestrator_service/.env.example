# =========================================================
# 🌐 SERVER CONFIG
# =========================================================

# Optional: external auth service
AUTHENTICATE_ACCOUNT_URL=


# =========================================================
# 🔐 MEZON OAUTH2 AUTHENTICATION
# =========================================================
# Get credentials from Mezon Developer Portal: https://mezon.ai/developers
MEZON_CLIENT_ID=your_client_id_here
MEZON_CLIENT_SECRET=your_client_secret_here
MEZON_REDIRECT_URI=http://localhost:3000/callback
MEZON_AUTH_URL=https://your-oauth2-domain/oauth2/auth
MEZON_TOKEN_URL=https://your-oauth2-domain/oauth2/token
MEZON_USERINFO_URL=https://your-oauth2-domain/userinfo


# JWT token configuration
JWT_SECRET=your-secure-random-secret-key-here
JWT_EXPIRY_DAYS=1

# Refresh token configuration
REFRESH_TOKEN_EXPIRY_DAYS=5

# =========================================================
# 🎥 LIVEKIT CONFIG
# =========================================================
# WebSocket URL
LIVEKIT_URL=

# HTTP API URL
LIVEKIT_HTTP_URL=

# API credentials
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent name
LIVEKIT_AGENT_NAME=agent-e7e1b7c2-2b6e-4e2a-9c1d-7f8e2a1b2c3d

# Webhook verification (recommended true)
LIVEKIT_VERIFY_WEBHOOKS=true

# Optional separate webhook credentials
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=

# Local recordings folder
RECORDINGS_DIR=/recordings


# =========================================================
# 🗄️ MONGODB CONFIG (kept for data migration reference)
# =========================================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=rootpassword
MONGODB_DATABASE=mezon_transcripts
MONGODB_COLLECTION=transcripts


# =========================================================
# 🐘 POSTGRESQL CONFIG (primary database)
# =========================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=mezon_transcripts
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20


# =========================================================
# 📦 MINIO / S3 STORAGE (recordings upload)
# =========================================================
MINIO_ENABLED=true
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET=minioadmin123
MINIO_BUCKET=livekit-recordings
MINIO_REGION=us-east-1


# =========================================================
# 🪵 LOGGER
# =========================================================
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR

INTERNAL_API_SECRET=

# =========================================================
# 🤖 AI & LLM Services
# =========================================================
# API key for the selected provider
GEMINI_API_KEY=your_gemini_api_key
LOCAL_LLM_API_KEY=your_local_api_key

# Local LLM URL (required for local/openai providers)
# For local: http://localhost:8080/v1/chat/completions
# For OpenAI: https://api.openai.com/v1 (or leave empty for default)
LOCAL_LLM_URL=https://api.openai.com/v1


# =========================================================
# 🔴 NOTIFICATION CONFIG (Mezon Webhook)
# =========================================================

NOTIFICATION_ENABLED=true
NOTIFICATION_WEBHOOK_ENDPOINT="https://your_web_hook/webhooks"
NOTIFICATION_CHANNEL_ID=""
NOTIFICATION_WEBHOOK_TOKEN=""

# =========================================================
# OUTBOX_CONFIG
# =========================================================
OUTBOX_CHECK_INTERVAL_SEC=30
OUTBOX_DELAY_BETWEEN_ITEMS_SEC=30
OUTBOX_BATCH_LIMIT=5
OUTBOX_RETRY_SUMMARIZATION_TARGET_HOURS=12,13,14


# =========================================================
# SUMMARY CONFIG
# =========================================================

SUMMARY_LLM_PROVIDER=local
SUMMARY_LLM_MODEL=Qwen3.5-35B-A3B
SUMMARY_LLM_TEMPERATURE=0.4
SUMMARY_LLM_TIMEOUT=120
SUMMARY_LANGUAGE=Vietnamese
SUMMARY_LLM_RETRY_COUNT=3

SUMMARY_LLM_FALLBACK_ENABLE=true
SUMMARY_LLM_FALLBACK_PROVIDER=gemini
SUMMARY_LLM_FALLBACK_MODEL=gemma-4-31b-it
SUMMARY_LLM_FALLBACK_TEMPERATURE=0.4
SUMMARY_LLM_FALLBACK_TIMEOUT=120
SUMMARY_LLM_FALLBACK_RETRY_COUNT=3

SUMMARY_THRESHOLD_MIN=20


# =========================================================
# SUMMARY CONFIG
# =========================================================

LIGHT_SUMMARY_TARGER_DURATION_MIN=15
LIGHT_SUMMARY_EXTEND_MIN=5
LIGHT_SUMMARY_MAX_DURATION_MIN=30

LIGHT_SUMMARY_LLM_PROVIDER=gemini
LIGHT_SUMMARY_LLM_MODEL=gemma-4-31b-it
LIGHT_SUMMARY_LLM_TEMPERATURE=0.4
LIGHT_SUMMARY_TIMEOUT=120
LIGHT_SUMMARY_LLM_RETRY_COUNT=3
