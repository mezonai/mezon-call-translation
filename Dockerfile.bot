FROM node:18-bullseye

WORKDIR /app/bot

# Install build dependencies for native modules (e.g., better-sqlite3)
RUN apt-get update && apt-get install -y \
  python3 \
  make \
  g++ \
  && rm -rf /var/lib/apt/lists/*

# Copy bot source code
COPY Architect_MultiClient_Server/bot/ .

# Clean any host node_modules accidentally copied and install fresh
RUN rm -rf node_modules && \
    yarn install --frozen-lockfile --production && \
    npx --yes node-gyp install || true && \
    npm rebuild better-sqlite3 --build-from-source || true

# Set env
ENV NODE_ENV=production

# Expose WS port
EXPOSE 8080

# Use node directly (avoid nodemon in production)
CMD ["node", "index.js"]


